# Copy this file to .env (repo root) and fill in real values.
# NEVER commit the real .env file — it holds secrets.
# docker-compose.yml reads this file automatically to set up the db and
# redis containers. Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

POSTGRES_USER=marine
POSTGRES_PASSWORD=change-me-to-a-random-value
POSTGRES_DB=marine_annotate

REDIS_PASSWORD=change-me-to-a-random-value
