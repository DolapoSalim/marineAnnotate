# Copy this file to .env (repo root) and fill in real values.
# NEVER commit the real .env file — it holds secrets.
# docker-compose.yml reads this file automatically to set up the db and
# redis containers. Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

POSTGRES_USER=marine
POSTGRES_PASSWORD=change-me-to-a-random-value
POSTGRES_DB=marine_annotate

REDIS_PASSWORD=change-me-to-a-random-value

# Only used by the optional Caddy TLS proxy (docker compose --profile tls).
# Set this to your real public domain (e.g. lab.example.org) pointed at this
# server's IP for automatic Let's Encrypt HTTPS. Leave as localhost/an IP for
# an internal-network deployment — Caddy will use a self-signed cert instead.
DOMAIN=localhost

# Only used by the optional named Cloudflare Tunnel (docker compose
# --profile tunnel-named) — a stable, permanent address for remote lab
# members, as an upgrade from the free `--profile tunnel` quick address
# (no setup, but ephemeral). Get this token by creating a named tunnel in
# the Cloudflare Zero Trust dashboard (free account + a domain you own).
TUNNEL_TOKEN=
