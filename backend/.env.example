# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file — it holds secrets. This example file only
# holds placeholders and safe defaults.

# ── Database ──────────────────────────────────────────────────────────────────
# When running via `docker compose up`, this is ignored — docker-compose.yml
# builds it from the root .env's POSTGRES_USER/POSTGRES_PASSWORD instead. This
# value only matters if you run the backend directly (outside Docker).
DATABASE_URL=postgresql+asyncpg://marine:marine@localhost:5432/marine_annotate

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-48-byte-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
INVITE_TOKEN_EXPIRE_HOURS=48

# ── Redis ─────────────────────────────────────────────────────────────────────
# Same as DATABASE_URL above — docker-compose.yml overrides this with the root
# .env's REDIS_PASSWORD. Only matters outside Docker.
REDIS_URL=redis://localhost:6379/0

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PATH=./storage
MODELS_PATH=./storage/models
IMAGES_PATH=./storage/images
MAX_UPLOAD_SIZE_MB=50
# Whole-request ceiling — covers multi-file image batches and model uploads
# (up to 2GB). Must be >= the largest model file admins will upload.
MAX_REQUEST_SIZE_MB=2200

# ── First admin ───────────────────────────────────────────────────────────────
# Change the password immediately after first login.
FIRST_ADMIN_EMAIL=admin@lab.local
FIRST_ADMIN_PASSWORD=change-me-now-1234

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── SMTP (optional — falls back to console log if not set) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@marinelab.local
SMTP_TLS=true

# ── App public URL (used in invite links) ──────────────────────────────────────
APP_URL=http://localhost:5173

# ── Environment ─────────────────────────────────────────────────────────────────
# Keep false in production — true exposes /docs, /redoc, /openapi.json.
DEBUG=false
